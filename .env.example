# Copy this file to .env and fill in your own values.
# Never commit .env: it is listed in .gitignore.

# LLM (https://console.groq.com)
GROQ_API_KEY=

# Embeddings (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Option A: cloud database (e.g. Neon). If set, this is used.
DATABASE_URL=

# Option B: local Postgres with pgvector (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=yojana
DB_USER=
DB_PASSWORD=

# Frontend URLs allowed to call the API (comma-separated, no spaces)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500